# Data provider:
#   "mock"     — bundled demo dataset (no DB)
#   "sec13f"   — live Prisma/SQLite (local sync via `npm run sync -- --all`)
#   "snapshot" — production: reads data/snapshot.json (committed at build time)
DATA_PROVIDER=mock

# Only used when DATA_PROVIDER=sec13f. SQLite for local dev.
DATABASE_URL="file:./dev.db"

# SEC EDGAR requires a descriptive User-Agent. Only used by the local sync script.
# Format: "Name contact@example.com"
SEC_USER_AGENT="Holdings Tracker dev@example.com"
